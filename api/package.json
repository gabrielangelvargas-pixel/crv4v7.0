    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
