{
  "name": "crv4-api",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "API de CRV4 Mayorista 7.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/servidor.ts",
